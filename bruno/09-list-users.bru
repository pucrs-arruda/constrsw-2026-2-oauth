meta {
  name: 09 - List Users
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const users = res.getBody();
    if (Array.isArray(users)) {
      const pessoa4 = users.find(function (u) { return u.username === "pessoa4.user@example.com"; });
      if (pessoa4) {
        bru.setVar("user_id", pessoa4.id);
        bru.setEnvVar("user_id", pessoa4.id);
      }
    }
  }
}

tests {
  test("lista usuarios sem expor senha", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body).to.be.an("array");
    body.forEach(function (user) {
      expect(user).not.to.have.property("password");
      expect(user).not.to.have.property("credentials");
    });
  });
}
