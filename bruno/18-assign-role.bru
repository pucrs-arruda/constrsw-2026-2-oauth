meta {
  name: 18 - Assign Role
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/users/{{user_id}}/roles/{{role_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

tests {
  test("atribui realm role ao usuario", function () {
    expect([204, 409]).to.include(res.getStatus());
    if (res.getStatus() === 204) {
      expect(res.getBody()).to.equal("");
    }
  });
}
