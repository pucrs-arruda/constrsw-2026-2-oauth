meta {
  name: 10 - Get User
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/users/{{user_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

tests {
  test("recupera o usuario criado sem senha", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.id).to.equal(bru.getVar("user_id") || bru.getEnvVar("user_id"));
    expect(body).not.to.have.property("password");
    expect(body).not.to.have.property("credentials");
  });
}
