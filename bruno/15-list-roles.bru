meta {
  name: 15 - List Roles
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/roles
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const roles = res.getBody();
    if (Array.isArray(roles)) {
      const role = roles.find(function (r) {
        return r.name === "pessoa4-test-role" || r.name === "pessoa4-test-role-updated";
      });
      if (role) {
        bru.setVar("role_id", role.id);
        bru.setEnvVar("role_id", role.id);
      }
    }
  }
}

tests {
  test("lista realm roles", function () {
    const body = res.getBody();
    const currentRoleId = bru.getVar("role_id") || bru.getEnvVar("role_id");

    expect(res.getStatus()).to.equal(200);
    expect(body).to.be.an("array");
    expect(body.some(function (role) {
      return role.id === currentRoleId || role.name === "pessoa4-test-role" || role.name === "pessoa4-test-role-updated";
    })).to.equal(true);
  });
}
