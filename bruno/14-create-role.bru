meta {
  name: 14 - Create Role
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "{{role_name}}",
    "description": "Role de teste da Pessoa 4"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const id = res.getBody().id;
    bru.setVar("role_id", id);
    bru.setEnvVar("role_id", id);
  }
}

tests {
  test("cria role ou valida existencia", function () {
    const status = res.getStatus();
    expect([201, 409]).to.include(status);

    if (status === 201) {
      const body = res.getBody();
      expect(body.name).to.equal(bru.getEnvVar("role_name") || bru.getVar("role_name") || "pessoa4-test-role");
      expect(body).to.have.property("id").that.is.a("string").and.not.empty;
      expect(bru.getVar("role_id") || bru.getEnvVar("role_id")).to.equal(body.id);
    } else {
      const body = res.getBody();
      expect(body.error_code).to.equal("OA-409");
    }
  });
}

docs {
  Cria o realm role de teste e salva o id retornado para os requests de
  consulta, update e vinculo. Reexecutar depois da primeira execucao deve
  retornar 409 por nome duplicado.
}
