{
  "info": {
    "name": "ConstrSW OAuth - contrato completo",
    "description": "Fluxo de validação do enunciado: Health, Auth, Users, Roles, atribuição de roles e erros. Rode a collection inteira (Collection Runner) na ordem das pastas: 02 guarda access-token/refresh-token, 03 e 04 criam os recursos e guardam user-id/role-id usados depois. Users e Roles exigem Authorization: Bearer {{access-token}}. O /refresh rotaciona o refresh token (revokeRefreshToken=true no realm).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base-api-url", "value": "http://localhost:8181" },
    { "key": "username", "value": "admin@pucrs.br" },
    { "key": "password", "value": "a12345678" },
    { "key": "forbidden-username", "value": "professor@pucrs.br" },
    { "key": "forbidden-password", "value": "a12345678" },
    { "key": "access-token", "value": "" },
    { "key": "refresh-token", "value": "" },
    { "key": "previous-refresh-token", "value": "" },
    { "key": "forbidden-token", "value": "" },
    { "key": "user-id", "value": "" },
    { "key": "created-user", "value": "" },
    { "key": "role-id", "value": "" },
    { "key": "role-name", "value": "" },
    { "key": "missing-id", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "GET /health - 200",
          "request": { "method": "GET", "url": "{{base-api-url}}/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('health payload', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', service: 'oauth' }));"
          ] } }]
        }
      ]
    },
    {
      "name": "02 - Auth",
      "item": [
        {
          "name": "POST /login - 201 (admin)",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "username", "value": "{{username}}", "type": "text" },
              { "key": "password", "value": "{{password}}", "type": "text" }
            ] },
            "url": "{{base-api-url}}/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "['token_type','access_token','expires_in','refresh_token','refresh_expires_in'].forEach((key) => pm.test(key + ' present', () => pm.expect(body).to.have.property(key)));",
            "pm.collectionVariables.set('access-token', body.access_token);",
            "pm.collectionVariables.set('refresh-token', body.refresh_token);"
          ] } }]
        },
        {
          "name": "POST /refresh - 201 (cookie de sessão) e rotação",
          "request": { "method": "POST", "url": "{{base-api-url}}/refresh" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.expect(body).to.have.property('access_token');",
            "const previousRefresh = pm.collectionVariables.get('refresh-token');",
            "const previousAccess = pm.collectionVariables.get('access-token');",
            "pm.collectionVariables.set('previous-refresh-token', previousRefresh);",
            "pm.test('access token novo', () => pm.expect(body.access_token).to.not.eql(previousAccess));",
            "pm.test('refresh token rotacionado', () => pm.expect(body.refresh_token).to.be.a('string'));",
            "pm.test('refresh token diferente do anterior', () => pm.expect(body.refresh_token).to.not.eql(previousRefresh));",
            "pm.collectionVariables.set('access-token', body.access_token);",
            "pm.collectionVariables.set('refresh-token', body.refresh_token);"
          ] } }]
        },
        {
          "name": "POST /login - token sem permissão (professor)",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "username", "value": "{{forbidden-username}}", "type": "text" },
              { "key": "password", "value": "{{forbidden-password}}", "type": "text" }
            ] },
            "url": "{{base-api-url}}/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('forbidden-token', pm.response.json().access_token);"
          ] } }]
        },
        {
          "name": "POST /login - 400 estrutura inválida",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "username", "value": "invalid", "type": "text" },
              { "key": "password", "value": "", "type": "text" }
            ] },
            "url": "{{base-api-url}}/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 400', () => pm.response.to.have.status(400));",
            "pm.test('error envelope', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['error_code','error_description','error_source','error_stack']));",
            "pm.test('error_code OA-400', () => pm.expect(pm.response.json().error_code).to.eql('OA-400'));"
          ] } }]
        },
        {
          "name": "POST /login - 401 credenciais inválidas",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "username", "value": "{{username}}", "type": "text" },
              { "key": "password", "value": "senha-invalida", "type": "text" }
            ] },
            "url": "{{base-api-url}}/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));",
            "pm.expect(pm.response.json().error_code).to.eql('OA-401');"
          ] } }]
        }
      ]
    },
    {
      "name": "03 - Users - fluxo feliz",
      "item": [
        {
          "name": "POST /users - 201 create (username = e-mail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access-token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{created-user}}\",\n  \"password\": \"senha-segura\",\n  \"first-name\": \"Postman\",\n  \"last-name\": \"User\"\n}" },
            "url": "{{base-api-url}}/users"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('created-user', 'postman-' + Date.now() + '@pucrs.br');"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('id present', () => pm.expect(body.id).to.be.ok);",
              "pm.test('username echoes created-user', () => pm.expect(body.username).to.eql(pm.collectionVariables.get('created-user')));",
              "pm.test('first-name present', () => pm.expect(body['first-name']).to.eql('Postman'));",
              "pm.test('last-name present', () => pm.expect(body['last-name']).to.eql('User'));",
              "pm.test('enabled true', () => pm.expect(body.enabled).to.eql(true));",
              "pm.test('resposta não expõe email', () => pm.expect(body).to.not.have.property('email'));",
              "pm.collectionVariables.set('user-id', body.id);"
            ] } }
          ]
        },
        {
          "name": "GET /users - 200 list",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access-token}}" }], "url": "{{base-api-url}}/users" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.expect(pm.response.json()).to.be.an('array');"
          ] } }]
        },
        {
          "name": "GET /users?enabled=true - 200",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access-token}}" }], "url": "{{base-api-url}}/users?enabled=true" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.response.json().forEach((user) => pm.expect(user.enabled).to.eql(true));"
          ] } }]
        },
        {
          "name": "GET /users?enabled=false - 200",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access-token}}" }], "url": "{{base-api-url}}/users?enabled=false" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.response.json().forEach((user) => pm.expect(user.enabled).to.eql(false));"
          ] } }]
        },
        {
          "name": "GET /users/:id - 200",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access-token}}" }], "url": "{{base-api-url}}/users/{{user-id}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body).to.have.property('id');",
            "pm.expect(body).to.not.have.property('email');"
          ] } }]
        },
        {
          "name": "PUT /users/:id - 200 update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access-token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{created-user}}\",\n  \"first-name\": \"Updated\",\n  \"last-name\": \"User\"\n}" },
            "url": "{{base-api-url}}/users/{{user-id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('empty body', () => pm.expect(pm.response.text()).to.eql(''));"
          ] } }]
        },
        {
          "name": "PATCH /users/:id - 200 senha",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access-token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"nova-senha-segura\"\n}" },
            "url": "{{base-api-url}}/users/{{user-id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('empty body', () => pm.expect(pm.response.text()).to.eql(''));"
          ] } }]
        }
      ]
    },
